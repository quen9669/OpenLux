# /etc/systemd/system/openlux.service
# Service systemd pour le serveur web OpenLux Hub (API REST + Dashboard + Métriques Prometheus)

[Unit]
Description=OpenLux Hub - API & Dashboard Publics
After=network.target

[Service]
Type=simple
User=openlux
Group=openlux
WorkingDirectory=/opt/openlux-hub
Environment="PATH=/home/openlux/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="OPENLUX_AUTO_SYNC=0"
ExecStart=/home/openlux/.cargo/bin/uv run openlux serve --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

# Durcissement de sécurité (Zero-Trust)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/openlux-hub/data /opt/openlux-hub/logs
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
