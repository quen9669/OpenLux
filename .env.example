# OpenLux Hub - Variables d'environnement optionnelles
# Aucune variable n'est obligatoire pour le fonctionnement offline ou les sources ouvertes.

# Alerting (Discord / Telegram Webhook URL)
# Utilisé par core/monitoring.py en cas d'erreur critique ou 3 warnings consécutifs
OPENLUX_ALERT_WEBHOOK_URL=

# data.public.lu Publication API (Phase 4)
DATAGOUV_API_KEY=

# Clés API externes optionnelles (bascule automatique sur fallback/backup si absentes)
METEOLUX_API_KEY=
TOMTOM_API_KEY=
TICKETMASTER_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
