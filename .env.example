# OpenLux Hub - Variables d'environnement optionnelles
# Aucune variable n'est obligatoire : sans clé, la source bascule sur son backup ou passe NOT_TESTED.

# Vel'oh temps réel (JCDecaux v3). Sans clé : backup GBFS public (statut ATTENTION).
JCDECAUX_API_KEY=

# Alerting (webhook Discord / Telegram) utilisé par core/monitoring.py
OPENLUX_ALERT_WEBHOOK_URL=

# Publication data.public.lu (non implémentée : seules les métadonnées sont écrites)
DATA_PUBLIC_LU_API_KEY=
